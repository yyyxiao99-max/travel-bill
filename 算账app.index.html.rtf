                list.innerHTML = project.activities.map((activity, index) => \{\
                    const imagesHtml = activity.images && activity.images.length > 0 \
                        ? `<div class="activity-images">$\{activity.images.map(img => `<img src="$\{img\}" onclick="viewImage('$\{img\}')">`).join('')\}</div>`\
                        : '';\
                    \
                    const detailText = activity.type === 'avg' \
                        ? `\uc0\u20154 \u22343 \u65306 \'a5$\{(activity.totalAmount / activity.members.length).toFixed(2)\}`\
                        : activity.memberAmounts.map(ma => `$\{ma.member\}\uc0\u65306 \'a5$\{ma.amount.toFixed(2)\}`).join('\u65292 ');\
                    \
                    return `\
                        <div class="activity-item">\
                            <div class="activity-header">\
                                <div class="activity-name">$\{activity.name\}</div>\
                                <div class="activity-amount">\'a5$\{activity.totalAmount.toFixed(2)\}</div>\
                            </div>\
                            <div class="activity-detail">\
                                $\{activity.members.join('\uc0\u12289 ')\} \'b7 $\{activity.type === 'avg' ? '\u24179 \u22343 \u33457 \u36153 ' : '\u19981 \u24179 \u22343 \u33457 \u36153 '\}\
                            </div>\
                            <div class="activity-detail">$\{detailText\}</div>\
                            $\{imagesHtml\}\
                            <div class="activity-actions">\
                                <button class="delete-btn" onclick="deleteActivity($\{index\})">\uc0\u21024 \u38500 </button>\
                            </div>\
                        </div>\
                    `;\
                \}).join('');\
            \}\
        \}\
\
        // \uc0\u28210 \u26579 \u32467 \u31639 \
        function renderSettlement() \{\
            const project = projects[currentProjectIndex];\
            const total = calculateTotal(project);\
            const personTotals = calculatePersonTotals(project);\
            \
            const settlementHtml = `\
                <div class="settlement">\
                    <div class="settlement-title">\uc0\u55357 \u56462  \u39033 \u30446 \u32467 \u31639 </div>\
                    <div class="settlement-total">\uc0\u24635 \u33457 \u36153 \u65306 \'a5$\{total.toFixed(2)\}</div>\
                    $\{project.members.map(member => `\
                        <div class="settlement-person">\
                            <span class="settlement-person-name">$\{member\}</span>\
                            <span class="settlement-person-amount">\'a5$\{(personTotals[member] || 0).toFixed(2)\}</span>\
                        </div>\
                    `).join('')\}\
                </div>\
            `;\
            \
            document.getElementById('settlementArea').innerHTML = settlementHtml;\
        \}\
\
        // \uc0\u35745 \u31639 \u24635 \u33457 \u36153 \
        function calculateTotal(project) \{\
            return project.activities.reduce((sum, activity) => sum + activity.totalAmount, 0);\
        \}\
\
        // \uc0\u35745 \u31639 \u27599 \u20154 \u24635 \u33457 \u36153 \
        function calculatePersonTotals(project) \{\
            const totals = \{\};\
            project.members.forEach(m => totals[m] = 0);\
            \
            project.activities.forEach(activity => \{\
                if (activity.type === 'avg') \{\
                    const perPerson = activity.totalAmount / activity.members.length;\
                    activity.members.forEach(m => \{\
                        totals[m] += perPerson;\
                    \});\
                \} else \{\
                    activity.memberAmounts.forEach(ma => \{\
                        totals[ma.member] += ma.amount;\
                    \});\
                \}\
            \});\
            \
            return totals;\
        \}\
\
        // \uc0\u26174 \u31034 \u32534 \u36753 \u25104 \u21592 \u24377 \u31383 \
        function showEditMembers() \{\
            const project = projects[currentProjectIndex];\
            document.getElementById('editMembersInput').value = project.members.join(',');\
            document.getElementById('editMembersModal').style.display = 'flex';\
        \}\
\
        // \uc0\u26356 \u26032 \u25104 \u21592 \
        function updateMembers() \{\
            const membersStr = document.getElementById('editMembersInput').value.trim();\
            const members = membersStr.split(/[,\uc0\u65292 \u12289 \\s]+/).filter(m => m);\
            \
            if (members.length < 2 || members.length > 10) \{\
                alert('\uc0\u25104 \u21592 \u25968 \u37327 \u38656 \u35201 \u22312 2-10\u20154 \u20043 \u38388 ');\
                return;\
            \}\
            \
            projects[currentProjectIndex].members = members;\
            saveProjects();\
            renderProjectDetails();\
            closeModal('editMembersModal');\
        \}\
\
        // \uc0\u26174 \u31034 \u28155 \u21152 \u27963 \u21160 \u24377 \u31383 \
        function showAddActivity() \{\
            const project = projects[currentProjectIndex];\
            selectedMembers = [];\
            tempImages = [];\
            currentActivityImages = [];\
            \
            document.getElementById('activityName').value = '';\
            document.getElementById('totalAmount').value = '';\
            selectType('avg');\
            renderActivityMembers();\
            renderCustomInputs();\
            renderImageUploads();\
            \
            document.getElementById('addActivityModal').style.display = 'flex';\
        \}\
\
        // \uc0\u36873 \u25321 \u33457 \u36153 \u31867 \u22411 \
        function selectType(type) \{\
            currentType = type;\
            document.getElementById('typeAvg').className = 'radio-option' + (type === 'avg' ? ' active' : '');\
            document.getElementById('typeCustom').className = 'radio-option' + (type === 'custom' ? ' active' : '');\
            \
            document.getElementById('avgInputArea').style.display = type === 'avg' ? 'block' : 'none';\
            document.getElementById('customInputArea').style.display = type === 'custom' ? 'block' : 'none';\
            \
            renderCustomInputs();\
        \}\
\
        // \uc0\u28210 \u26579 \u27963 \u21160 \u25104 \u21592 \u36873 \u25321 \
        function renderActivityMembers() \{\
            const project = projects[currentProjectIndex];\
            const container = document.getElementById('activityMembers');\
            \
            container.innerHTML = project.members.map(member => `\
                <span class="member-tag $\{selectedMembers.includes(member) ? 'selected' : ''\}" \
                      onclick="toggleMember('$\{member\}')">$\{member\}</span>\
            `).join('');\
        \}\
\
        // \uc0\u20999 \u25442 \u25104 \u21592 \u36873 \u25321 \
        function toggleMember(member) \{\
            const index = selectedMembers.indexOf(member);\
            if (index > -1) \{\
                selectedMembers.splice(index, 1);\
            \} else \{\
                selectedMembers.push(member);\
            \}\
            renderActivityMembers();\
            renderCustomInputs();\
        \}\
\
        // \uc0\u28210 \u26579 \u33258 \u23450 \u20041 \u36755 \u20837 \
        function renderCustomInputs() \{\
            const container = document.getElementById('customAmountInputs');\
            \
            if (currentType !== 'custom') \{\
                container.innerHTML = '';\
                return;\
            \}\
            \
            container.innerHTML = selectedMembers.map(member => `\
                <div class="input-group">\
                    <label>$\{member\}\uc0\u30340 \u33457 \u36153 \u65288 \u20803 \u65289 </label>\
                    <input type="number" class="custom-amount" data-member="$\{member\}" placeholder="0.00" step="0.01">\
                </div>\
            `).join('');\
        \}\
\
        // \uc0\u28155 \u21152 \u22270 \u29255 \
        function addImage() \{\
            if (currentActivityImages.length >= 3) \{\
                alert('\uc0\u26368 \u22810 \u19978 \u20256 3\u24352 \u22270 \u29255 ');\
                return;\
            \}\
            document.getElementById('imageInput').click();\
        \}\
\
        // \uc0\u22788 \u29702 \u22270 \u29255 \u19978 \u20256 \
        function handleImageUpload(event) \{\
            const files = event.target.files;\
            \
            for (let file of files) \{\
                if (currentActivityImages.length >= 3) \{\
                    alert('\uc0\u26368 \u22810 \u19978 \u20256 3\u24352 \u22270 \u29255 ');\
                    break;\
                \}\
                \
                const reader = new FileReader();\
                reader.onload = function(e) \{\
                    currentActivityImages.push(e.target.result);\
                    renderImageUploads();\
                \};\
                reader.readAsDataURL(file);\
            \}\
            \
            event.target.value = '';\
        \}\
\
        // \uc0\u28210 \u26579 \u22270 \u29255 \u19978 \u20256 \
        function renderImageUploads() \{\
            const container = document.getElementById('imageUploadArea');\
            \
            const imagesHtml = currentActivityImages.map((img, index) => `\
                <div class="image-preview-wrapper">\
                    <img src="$\{img\}" class="image-preview">\
                    <button class="image-remove" onclick="removeImage($\{index\})">\uc0\u10005 </button>\
                </div>\
            `).join('');\
            \
            const uploadBtn = currentActivityImages.length < 3 \
                ? '<button class="upload-btn" onclick="addImage()">\uc0\u65291 </button>'\
                : '';\
            \
            container.innerHTML = imagesHtml + uploadBtn;\
        \}\
\
        // \uc0\u31227 \u38500 \u22270 \u29255 \
        function removeImage(index) \{\
            currentActivityImages.splice(index, 1);\
            renderImageUploads();\
        \}\
\
        // \uc0\u20445 \u23384 \u27963 \u21160 \
        function saveActivity() \{\
            const name = document.getElementById('activityName').value.trim();\
            \
            if (!name) \{\
                alert('\uc0\u35831 \u36755 \u20837 \u27963 \u21160 \u21517 \u31216 ');\
                return;\
            \}\
            \
            if (selectedMembers.length === 0) \{\
                alert('\uc0\u35831 \u36873 \u25321 \u21442 \u19982 \u25104 \u21592 ');\
                return;\
            \}\
            \
            let activity = \{\
                name: name,\
                type: currentType,\
                members: [...selectedMembers],\
                images: [...currentActivityImages],\
                totalAmount: 0,\
                memberAmounts: []\
            \};\
            \
            if (currentType === 'avg') \{\
                const totalAmount = parseFloat(document.getElementById('totalAmount').value);\
                if (!totalAmount || totalAmount <= 0) \{\
                    alert('\uc0\u35831 \u36755 \u20837 \u26377 \u25928 \u30340 \u24635 \u33457 \u36153 ');\
                    return;\
                \}\
                activity.totalAmount = totalAmount;\
            \} else \{\
                const customInputs = document.querySelectorAll('.custom-amount');\
                let totalAmount = 0;\
                \
                customInputs.forEach(input => \{\
                    const member = input.dataset.member;\
                    const amount = parseFloat(input.value) || 0;\
                    totalAmount += amount;\
                    activity.memberAmounts.push(\{\
                        member: member,\
                        amount: amount\
                    \});\
                \});\
                \
                activity.totalAmount = totalAmount;\
            \}\
            \
            projects[currentProjectIndex].activities.push(activity);\
            saveProjects();\
            renderProjectDetails();\
            closeModal('addActivityModal');\
        \}\
\
        // \uc0\u21024 \u38500 \u27963 \u21160 \
        function deleteActivity(index) \{\
            if (confirm('\uc0\u30830 \u23450 \u35201 \u21024 \u38500 \u36825 \u20010 \u27963 \u21160 \u21527 \u65311 ')) \{\
                projects[currentProjectIndex].activities.splice(index, 1);\
                saveProjects();\
                renderProjectDetails();\
            \}\
        \}\
\
        // \uc0\u21024 \u38500 \u39033 \u30446 \
        function deleteCurrentProject() \{\
            if (confirm('\uc0\u30830 \u23450 \u35201 \u21024 \u38500 \u25972 \u20010 \u39033 \u30446 \u21527 \u65311 \u27492 \u25805 \u20316 \u19981 \u21487 \u24674 \u22797 \u65281 ')) \{\
                projects.splice(currentProjectIndex, 1);\
                saveProjects();\
                backToHome();\
            \}\
        \}\
\
        // \uc0\u20851 \u38381 \u24377 \u31383 \
        function closeModal(modalId) \{\
            document.getElementById(modalId).style.display = 'none';\
        \}\
\
        // \uc0\u26597 \u30475 \u22270 \u29255 \
        function viewImage(src) \{\
            window.open(src, '_blank');\
        \}\
\
        // \uc0\u21021 \u22987 \u21270 \
        init();\
    </script>\
</body>\
</html>}